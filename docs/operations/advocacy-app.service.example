[Unit]
Description=AI for Advocacy prototype
After=network.target

[Service]
Type=simple
User=promptql
WorkingDirectory=/workspace/advocacy
ExecStart=/usr/bin/python3 /workspace/advocacy/server.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
