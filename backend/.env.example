# Optional documentation template; leave AI disabled for baseline testing.
# If copied to backend/.env, Settings loads it when run from backend/.
# Never commit a real .env or keys. No API key is needed for source retrieval.
ADVOCACY_LLM_PROVIDER=disabled
ADVOCACY_LLM_API_KEY=
ADVOCACY_LLM_MODEL=
ADVOCACY_LLM_CALLS_PER_HOUR=0
ADVOCACY_LLM_BUDGET_USD_PER_HOUR=0
ADVOCACY_LLM_INPUT_USD_PER_MILLION=0
ADVOCACY_LLM_OUTPUT_USD_PER_MILLION=0
ADVOCACY_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
ADVOCACY_API_TOKEN=
# Empty token permits loopback API access only. This example is not a remote deployment.
